{
  "cleanUrls": false,
  "functions": {
    "api/**/*.js": {
      "includeFiles": "datasets/archive/**"
    }
  },
  "rewrites": [
    {
      "source": "/home",
      "destination": "/index.html"
    },
    {
      "source": "/predict",
      "destination": "/predict.html"
    },
    {
      "source": "/results",
      "destination": "/results.html"
    },
    {
      "source": "/developer",
      "destination": "/developer.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/signin",
      "destination": "/login.html"
    }
  ]
}
